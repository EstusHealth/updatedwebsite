{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.estushealth.com"
        }
      ],
      "destination": "https://www.estushealth.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "estushealth.com"
        }
      ],
      "destination": "https://www.estushealth.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "estushealth.com.au"
        }
      ],
      "destination": "https://www.estushealth.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/learn/:slug",
      "destination": "/resources/:slug",
      "permanent": true
    },
    {
      "source": "/about/team",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/about/approach",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/for-referrers",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/quiz/learner-driver-style",
      "destination": "/resources/learner-driver-quiz",
      "permanent": true
    },
    {
      "source": "/resources/events",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/services/sleep-program",
      "destination": "/services/occupational-therapy",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/services/occupational-therapy",
      "permanent": true
    },
    {
      "source": "/services/minecraft-program",
      "destination": "/services/gaming-informed-therapy#minecraft",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
